FROM php:8.2-fpm-alpine

# Installation des dépendances nécessaires
RUN apk add --no-cache \
    git \
    unzip \
    libzip-dev \
    icu-dev \
    libpng-dev \
    oniguruma-dev \
    libxml2-dev

# Installation des extensions PHP
RUN docker-php-ext-install \
    pdo_mysql \
    intl \
    zip \
    opcache \
    gd \
    mbstring \
    exif \
    pcntl \
    bcmath \
    xml

# Installation de Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Définir le répertoire de travail
WORKDIR /var/www/symfony

# Création d'un utilisateur non-root avec des valeurs fixes
RUN addgroup -g 1000 symfony && \
    adduser -u 1000 -G symfony -s /bin/sh -D symfony

# Copier les fichiers du projet
COPY . .

# Configuration du propriétaire des fichiers
RUN chown -R symfony:symfony /var/www/symfony

# Passage à l'utilisateur non-root
USER symfony

# Installation des dépendances
RUN composer install --optimize-autoloader --no-dev

# Configuration de l'environnement
ENV APP_ENV=prod
ENV APP_DEBUG=0

# Optimisation pour la production
RUN php bin/console cache:clear --env=prod \
    && php bin/console cache:warmup --env=prod \
    && php bin/console assets:install public --env=prod

# Configuration pour Render
COPY docker/render/nginx.conf /etc/nginx/nginx.conf
COPY docker/render/supervisor.conf /etc/supervisor/conf.d/supervisord.conf

# Revenir à l'utilisateur root pour les dernières installations
USER root

# Installation de Nginx et Supervisor
RUN apk add --no-cache nginx supervisor

# Création du répertoire pour les logs
RUN mkdir -p /var/log/nginx && \
    mkdir -p /var/log/supervisor

# Exposition du port
EXPOSE 8080

# Commande de démarrage
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]