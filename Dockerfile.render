
FROM php:8.2-fpm-alpine

# Installation des dépendances nécessaires
RUN apk add --no-cache \
    git \
    unzip \
    libzip-dev \
    icu-dev \
    libpng-dev \
    oniguruma-dev \
    libxml2-dev \
    nginx \
    supervisor

# Installation des extensions PHP
RUN docker-php-ext-install \
    pdo_mysql \
    intl \
    zip \
    opcache \
    gd \
    mbstring \
    exif \
    pcntl \
    bcmath \
    xml

# Installation de Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Définition du répertoire de travail
WORKDIR /var/www/symfony

# Création du répertoire pour supervisor
RUN mkdir -p /etc/supervisor/conf.d

# Copie des fichiers de configuration avant de changer d'utilisateur
COPY --chown=root:root docker/render/nginx.conf /etc/nginx/nginx.conf
COPY --chown=root:root docker/render/supervisor.conf /etc/supervisor/conf.d/supervisord.conf

# Création d'un utilisateur non-root avec des valeurs fixes
RUN addgroup -g 1000 symfony && \
    adduser -u 1000 -G symfony -s /bin/sh -D symfony && \
    mkdir -p /var/www/symfony/var && \
    mkdir -p /var/www/symfony/vendor && \
    chown -R symfony:symfony /var/www/symfony

# Création des répertoires pour les logs
RUN mkdir -p /var/log/nginx \
    && mkdir -p /var/log/supervisor \
    && chown -R symfony:symfony /var/log/nginx \
    && chown -R symfony:symfony /var/log/supervisor

# Copie des fichiers du projet
COPY --chown=symfony:symfony . .

# Installation des dépendances en tant qu'utilisateur symfony
USER symfony
RUN composer install --optimize-autoloader --no-dev --no-scripts

# Optimisation pour la production
RUN php bin/console cache:clear --env=prod \
    && php bin/console cache:warmup --env=prod \
    && php bin/console assets:install public --env=prod

# Retour à l'utilisateur root pour la configuration finale
USER root

# S'assurer que les permissions sont correctes pour les fichiers sensibles
RUN chmod -R 777 /var/www/symfony/var

# Exposition du port utilisé par Render
EXPOSE 8080

# Commande de démarrage
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]